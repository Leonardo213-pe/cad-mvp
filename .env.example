# Ejemplo local sin credenciales. Exportar en el shell: .NET no carga .env automáticamente.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
AllowedHosts=localhost;127.0.0.1
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175
# Producción: definir hosts/orígenes reales explícitamente y HTTPS en el entorno de despliegue.
# No hay conexión Neon, secretos ni migraciones configuradas en esta etapa.
